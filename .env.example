# Nome do sistema (exibido no layout, PDF, título). Pode ser sobrescrito pela tabela settings (app_name).
APP_NAME="Sistema de Diárias"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# URL pública do sistema (usada no link de e-mail "Primeiro acesso / Redefinir senha")
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Pusher (WebSocket em tempo real). Crie um app em https://dashboard.pusher.com/
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=sa1

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailtrap (ou outro SMTP) – usado para "Primeiro acesso" e "Esqueci minha senha"
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
# IMPORTANTE: Use um domínio real (ex: noreply@sivis.pro). O domínio "example.com" é rejeitado por servidores SMTP.
MAIL_FROM_ADDRESS="noreply@sivis.pro"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
# Em dev com Vite em porta diferente do Laravel, use a URL do backend (ex: http://localhost:8000) para o Echo autenticar em /broadcasting/auth
# VITE_APP_URL="${APP_URL}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Web Push (notificações no navegador). Gere com: php artisan webpush:vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Opcional: contato do emissor (ex: mailto:admin@seudominio.com)
VAPID_SUBJECT=

# Site público — loteamento / Google Maps (opcional)
# LOTEAMENTO_NAME="Novo Loteamento — Cafarnaum, BA"
# LOTEAMENTO_ADDRESS="Cafarnaum, Bahia, Brasil"
# LOTEAMENTO_LAT=-11.4667
# LOTEAMENTO_LNG=-39.9833
# GOOGLE_MAPS_EMBED_URL=https://www.google.com/maps/embed?pb=...
# GOOGLE_MAPS_API_KEY=  # Maps JavaScript API — satélite Google nos mapas (Leaflet + Vue)
# VITE_GOOGLE_MAPS_API_KEY=  # opcional; se omitido, usa GOOGLE_MAPS_API_KEY no build Vite

# WPPConnect — verificação de WhatsApp (server-side)
WPPCONNECT_BASE_URL=https://wppconnect-server-production-9aa6.up.railway.app
WPPCONNECT_SESSION=Sid360
WPPCONNECT_TOKEN=
WHATSAPP_WEBHOOK_KEY=
WPPCONNECT_TIMEOUT=30
WPPCONNECT_MEDIA_TIMEOUT=90

# Efi Bank — pagamentos (PIX, boleto, carnê)
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
# Produção: false. Homologação: true. Se omitido, usa false quando APP_ENV=production.
EFI_SANDBOX=false
EFI_PIX_KEY=
EFI_CERTIFICATE_PATH=storage/app/private/homologacao-418288-Sid360.p12
# Deixe vazio se o certificado Efi não tiver senha (padrão)
EFI_CERTIFICATE_PASSWORD=
EFI_PIX_EXPIRY=3600
# Limite por folha de carnê/boleto na conta Efi (centavos). Padrão: R$ 2.000,00
EFI_CARNE_MAX_VALUE_CENTS=200000
# CPF do titular da conta Efi (opcional; bloqueia carnê/PIX/boleto antes de chamar a API)
EFI_HOLDER_CPF=

# Portal do comprador (meus pagamentos)
PORTAL_TOKEN_TTL_MINUTES=120
PORTAL_WHATSAPP_NUMBER=5574988230151

# Site público (WhatsApp nos CTAs; wa.me/{número sem +})
SITE_WHATSAPP_PHONE=5574988230151

# Cloudflare R2 — mídia (fotos/vídeos)
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=sid360-media
CLOUDFLARE_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_PUBLIC_URL=https://pub-<hash>.r2.dev
